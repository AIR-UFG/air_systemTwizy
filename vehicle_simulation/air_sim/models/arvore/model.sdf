<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="arvore">
    <!-- This makes the object static -->
    <static>true</static>
    <link name="link">
      <!-- Visual representation -->
      <visual name="visual">
      <laser_retro>7</laser_retro>
        <geometry>
          <mesh>
            <uri>model://arvore/meshes/pcl_arvore_esparsa.stl</uri>
            <scale>2 2 2</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>
      <!-- Optional collision representation -->
      <collision name="collision">
      <laser_retro>7</laser_retro>
        <geometry>
          <mesh>
            <uri>model://arvore/meshes/pcl_arvore_esparsa.stl</uri>
            <scale>2 2 2</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
