<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="parking_floor">
    <static>true</static>
    <link name="link"> <!-- fisical part of the model -->
      <pose>38.188500 -37.589400 2.753440 -0.002943 -0.002943 -2.798321</pose> <!-- Position and orientation of the parking floor (x, y, z, roll, pitch, yaw) -->
      <visual name="visual">
        <laser_retro>4</laser_retro>
        <geometry>
          <mesh>
            <uri>model://parking_floor/meshes/pcd_estacionamento_chao.stl</uri>
            <scale>4 4 4</scale>
          </mesh>
        </geometry>
        
        <material> <!-- Material/cor da mesh -->
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>

      <collision name="collision">
        <laser_retro>4</laser_retro> <!-- Laser retroreflection coefficient -->
        <geometry>
          <mesh>
            <uri>model://parking_floor/meshes/pcd_estacionamento_chao.stl</uri>
            <scale>4 4 4 </scale> <!-- Escala da mesh (tamanho original) -->
          </mesh>
        </geometry>

        <surface>
          <contact>
            <ode/>
          </contact>
          <bounce/>
          <friction>
            <torsional>
              <ode/>
            </torsional>
            <ode/>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
